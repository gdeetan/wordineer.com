<link rel="stylesheet" href="/styles/global.css?v=16">
<style>
.hub-wrap { max-width: 960px; margin: 0 auto; padding: 24px 24px 40px; }
.hub-wrap h2, .hub-wrap h3 { font-family: 'DM Serif Display', serif; font-weight: 400; }
.hub-intro { font-size: 16px; color: var(--text-2, #4b5563); line-height: 1.6; margin: 0 0 24px; }
.hub-intro strong { color: var(--text-1, #111827); }
.hub-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; margin: 0 0 32px; }
.hub-card { border: 1px solid var(--border-1, #e5e7eb); border-radius: 12px; padding: 18px 20px; background: #fff; scroll-margin-top: 90px; }
.hub-card h3 { margin: 0 0 4px; font-size: 22px; }
.hub-card .lvl-desc { font-size: 14px; color: var(--text-2, #4b5563); margin: 0 0 10px; }
.hub-card .lvl-count { font-size: 13px; color: var(--text-3, #6b7280); margin: 0 0 12px; }
.hub-card .lvl-links { display: flex; gap: 14px; flex-wrap: wrap; font-size: 14px; }
.hub-card .lvl-links a { color: var(--primary, #6366f1); text-decoration: none; font-weight: 600; }
.hub-card .lvl-links a:hover { text-decoration: underline; }
.hub-card .lvl-links .esl-pending { color: var(--text-3, #6b7280); font-weight: 500; }
.hub-badge { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .05em;
  padding: 3px 8px; border-radius: 999px; margin-right: 8px; vertical-align: middle; color: #fff; }
.cefr-A1 { background: #16a34a; }
.cefr-A2 { background: #65a30d; }
.cefr-B1 { background: #d97706; }
.cefr-B2 { background: #ea580c; }
.cefr-C1 { background: #dc2626; }
.cefr-C2 { background: #7c3aed; }
.exam-table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 0 0 12px; }
.exam-table th, .exam-table td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border-1, #e5e7eb); }
.exam-table thead th { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3, #6b7280); }
.exam-table td.verify { color: var(--text-3, #6b7280); font-style: italic; }
.exam-sources { font-size: 12px; color: var(--text-3, #6b7280); margin: 0 0 28px; }
.exam-sources a { color: inherit; }
.cite-box { border: 1px solid var(--border-1, #e5e7eb); border-radius: 10px; padding: 14px 18px; margin: 24px 0; background: var(--surface-1, #f9fafb); font-size: 13px; }
.cite-box code { display: block; padding: 6px 8px; background: #fff; border-radius: 6px; margin: 4px 0; word-break: break-word; }
.cite-box h3 { font-family: 'DM Sans', system-ui, sans-serif !important; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--text-3, #6b7280); font-weight: 700; margin: 0 0 8px; }
.hub-changelog { font-size: 13px; color: var(--text-2, #4b5563); margin: 12px 0 0; padding-left: 18px; }
.methodology p { font-size: 15px; color: var(--text-2, #4b5563); line-height: 1.6; }
.tool-link { display: inline-block; padding: 10px 16px; border: 1.5px solid var(--primary, #6366f1);
  color: var(--primary, #6366f1); border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; }
.tool-link:hover { background: var(--primary, #6366f1); color: #fff; }
.licensing-pending { border: 1px dashed var(--border-2, #d1d5db); border-radius: 10px; padding: 14px 18px;
  margin: 24px 0; background: #fffbeb; color: #92400e; font-size: 13px; }
</style>
</head>

