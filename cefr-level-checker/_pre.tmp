  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which CEFR level should I study?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pick the level one step above where reading feels easy. If B1 reading is comfortable, work on B2 vocabulary. Learning slightly above your current level builds comprehension faster than reviewing words you already know." }
    },
    {
      "@type": "Question",
      "name": "How does CEFR map to IELTS and TOEFL?",
      "acceptedAnswer": { "@type": "Answer", "text": "Under the TOEFL iBT 1–6 scale (in use for tests taken on or after January 21, 2026), a total score of 5 aligns with C1, 4 with B2, 3 with B1, 2 with A2, and 1 with A1. IELTS 7 aligns with C1, 6.5 with B2, and 5.5 with B1. See the exam mapping table above for exact bands and sources." }
    },
    {
      "@type": "Question",
      "name": "Where do the CEFR levels for these words come from?",
      "acceptedAnswer": { "@type": "Answer", "text": "Levels are read from Wordineer's cefr-lexicon dataset. Levels are not assigned by editorial judgment; if a word is not in the source dataset at a given level, it is not published at that level." }
    },
    {
      "@type": "Question",
      "name": "Can I print the lists or use them in class?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Each level page renders cleanly for printing, and every level has a CSV download. Content is available under CC BY 4.0 with attribution to Wordineer." }
    },
    {
      "@type": "Question",
      "name": "Can I import the CSV into Anki or Quizlet?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Each CSV has one row per word with columns: word, pos, level, ipa, definition, example. Both Anki and Quizlet accept comma-separated files with a header row." }
    },
    {
      "@type": "Question",
      "name": "Why is a particular word at this level?",
      "acceptedAnswer": { "@type": "Answer", "text": "Level assignment comes from the CEFR lexicon source. Wordineer does not re-tag levels by judgment. Within a level, the featured cards are the highest-frequency words according to wordfreq Zipf scores; the alphabetical table shows the full level." }
    }
  ]
}
</script>

